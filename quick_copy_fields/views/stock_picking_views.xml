<odoo>
    <data>
        <record id="view_picking_form_quick_copy" model="ir.ui.view">
            <field name="name">stock.picking.form.quick.copy</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="attributes">
                    <attribute name="widget">quick_copy_field</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
