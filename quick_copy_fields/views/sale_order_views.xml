<odoo>
    <data>
        <record id="view_order_form_quick_copy" model="ir.ui.view">
            <field name="name">sale.order.form.quick.copy</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="attributes">
                    <attribute name="widget">quick_copy_field</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
