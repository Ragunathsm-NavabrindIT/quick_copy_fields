<odoo>
    <data>
        <record id="product_template_form_view_quick_copy" model="ir.ui.view">
            <field name="name">product.template.form.quick.copy</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="default_code" widget="quick_copy_field" invisible="not default_code"/>
                </xpath>
            </field>
        </record>

        <record id="product_template_only_form_view_quick_copy" model="ir.ui.view">
            <field name="name">product.template.only.form.quick.copy</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="default_code" widget="quick_copy_field" invisible="not default_code"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
