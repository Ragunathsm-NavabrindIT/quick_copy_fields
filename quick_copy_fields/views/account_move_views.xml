<odoo>
    <data>
        <record id="view_move_form_quick_copy" model="ir.ui.view">
            <field name="name">account.move.form.quick.copy</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="attributes">
                    <attribute name="widget">quick_copy_field</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
